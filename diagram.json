{
  "version": 1,
  "author": "dibachain",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-s3-devkitc-1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-ssd1306", "id": "oled", "top": -120, "left": 160,
      "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-pushbutton", "id": "btnOk", "top": 120, "left": 150,
      "attrs": { "color": "green", "label": "OK" } },
    { "type": "wokwi-pushbutton", "id": "btnCancel", "top": 120, "left": 260,
      "attrs": { "color": "red", "label": "Cancel" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "oled:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "oled:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "oled:SDA", "esp:8", "green", [ "v0" ] ],
    [ "oled:SCL", "esp:9", "blue", [ "v0" ] ],

    [ "btnOk:1.l", "esp:0", "green", [ "v0" ] ],
    [ "btnOk:2.l", "esp:GND.2", "black", [ "v0" ] ],

    [ "btnCancel:1.l", "esp:14", "red", [ "v0" ] ],
    [ "btnCancel:2.l", "esp:GND.3", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
